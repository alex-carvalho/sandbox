      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sum by (service, span_name, status_code) (rate(traces_spanmetrics_calls_total[1m]))",
          "legendFormat": "{{service}} | {{span_name}} ({{status_code}})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Structured JSON logs from loan-frontend (Node.js), loan-backend (Go), and loan-underwriting (Python). Expand any log line and click 'View Trace in Tempo'!",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Correlated Polyglot Logs: Node.js Frontend + Go Backend + Python Underwriting (Loki -> Tempo)",
      "type": "logs",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"loan-frontend|loan-backend|loan-underwriting\"}",
          "refId": "A"
        }
      ]
    }
